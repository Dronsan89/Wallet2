# Контекст сборки docker-образов: только исходники.
# Кэши Go, артефакты сборки и служебные каталоги в образ не нужны.

# локальные кэши тулчейна (создаются scripts/dev-env.ps1)
.gocache/
.gomodcache/
.gotmp/

# git и IDE
.git/
.idea/
.vscode/

# собранные бинари
**/main
**/main.exe
*.exe
*.test
*.out

# логи и временные файлы
*.log
**/run.out
**/run.err

# технические каталоги
.verify/
_hidden/
