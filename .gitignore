# ---------------------------------------------------------------------------
# Локальные кэши Go-тулчейна (см. scripts/dev-env.ps1).
# В этом окружении GOCACHE/GOMODCACHE в профиле недоступны, поэтому они
# лежат внутри репозитория — в git им нельзя.
# ---------------------------------------------------------------------------
.gocache/
.gomodcache/
.gotmp/

# Технические артефакты workspace-режима Go
.verify/
go.work.sum

# ---------------------------------------------------------------------------
# Артефакты сборки сервисов: `go build -o main ./cmd` внутри модуля
# ---------------------------------------------------------------------------
/main
/main.exe
gw-exchanger/main
gw-exchanger/main.exe
gw-currency-wallet/main
gw-currency-wallet/main.exe
gw-notification/main
gw-notification/main.exe
gw-analytics/main
gw-analytics/main.exe
proto-exchange/main
proto-exchange/main.exe

*.exe
*.test
*.out
*.prof
bin/
dist/

# ---------------------------------------------------------------------------
# Тесты и покрытие
# ---------------------------------------------------------------------------
coverage.out
coverage.html
coverage.txt

# ---------------------------------------------------------------------------
# Секреты и локальные конфиги.
# config.env в git НУЖЕН: ТЗ требует его для локального запуска (`./main -c config.env`),
# поэтому игнорируем только личные переопределения.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.local.env
*.env.local

# ---------------------------------------------------------------------------
# Логи, временные файлы, данные контейнеров
# ---------------------------------------------------------------------------
*.log
logs/
tmp/
data/

# ---------------------------------------------------------------------------
# IDE и ОС
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini
