# gw-analytics — локальная конфигурация.
# Запуск: ./main -c config.env

APP_ENV=local
LOG_LEVEL=info

HTTP_PORT=8083
SHUTDOWN_TIMEOUT=20s

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=wallet.transactions
KAFKA_GROUP=gw-analytics
KAFKA_BATCH_SIZE=1000
KAFKA_POLL_TIMEOUT=500ms
KAFKA_COMMIT_TIMEOUT=5s
KAFKA_MAX_RETRIES=5
KAFKA_RETRY_BACKOFF=200ms

# ClickHouse (native protocol)
CLICKHOUSE_ADDR=localhost:9000
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_TIMEOUT=5s
CLICKHOUSE_MIGRATIONS=migrations/clickhouse
# Пересоздание reader, если сообщений нет дольше этого времени (0 — выключено).
KAFKA_IDLE_RECONNECT=2m
