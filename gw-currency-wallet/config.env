# gw-currency-wallet — локальная конфигурация.
# Запуск: ./main -c config.env

APP_ENV=local
LOG_LEVEL=info

HTTP_PORT=8080
SHUTDOWN_TIMEOUT=15s
MIGRATIONS_PATH=migrations

# PostgreSQL: DATABASE_URL приоритетнее отдельных DB_*
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=wallet
DB_PASSWORD=wallet
DB_NAME=wallet
DB_SSLMODE=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=5

# JWT
JWT_SECRET=dev-secret-change-me
JWT_TTL=24h

# gRPC-сервис курсов
EXCHANGER_GRPC_ADDR=localhost:50051
EXCHANGER_TIMEOUT=2s
RATES_CACHE_TTL=5s

# Kafka: события о крупных операциях
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=wallet.transactions
BIG_TRANSFER_THRESHOLD=30000