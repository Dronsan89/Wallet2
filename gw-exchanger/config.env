# gw-exchanger — локальная конфигурация.
# Запуск: ./main -c config.env

APP_ENV=local
LOG_LEVEL=info

GRPC_PORT=50051
SHUTDOWN_TIMEOUT=15s
MIGRATIONS_PATH=migrations

# PostgreSQL: DATABASE_URL приоритетнее отдельных DB_*
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=exchanger
DB_PASSWORD=exchanger
DB_NAME=exchanger
DB_SSLMODE=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2