# gw-notification — локальная конфигурация.
# Запуск: ./main -c config.env

APP_ENV=local
LOG_LEVEL=info

HTTP_PORT=8082
SHUTDOWN_TIMEOUT=20s

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=wallet.transactions
KAFKA_GROUP=gw-notification
KAFKA_DLQ_TOPIC=wallet.transactions.dlq
KAFKA_BATCH_SIZE=500
KAFKA_POLL_TIMEOUT=500ms
KAFKA_COMMIT_TIMEOUT=5s
KAFKA_MAX_RETRIES=5
KAFKA_RETRY_BACKOFF=200ms

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=notification
MONGO_COLLECTION=transfers
MONGO_CONNECT_TIMEOUT=5s
# Пересоздание reader, если сообщений нет дольше этого времени (0 — выключено).
KAFKA_IDLE_RECONNECT=2m
